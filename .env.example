# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me
MOCK_MODE=true
APP_DB_PATH=instance/soyoung_data_assistant.db

# LLM
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# Optional provider keys. Do not commit real keys.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=soyoung_data_assistant

# Doris
DORIS_HOST=localhost
DORIS_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=doris_document_db

# MaxCompute / ODPS
ODPS_ACCESS_ID=
ODPS_SECRET_ACCESS_KEY=
ODPS_PROJECT_NAME=soyoung_dw
ODPS_ENDPOINT=http://service.cn-shanghai.maxcompute.aliyun.com/api

